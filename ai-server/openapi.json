{
  "openapi": "3.0.0",
  "info": {
    "title": "Actual Intelligence API-DOC",
    "version": "1.0.0",
    "description": "API-Dokumentation für das Chatroom Backend.\n\n## 🔌 WebSocket Verbindung\n\nDie Echtzeit-Kommunikation läuft über WebSockets unter `ws://localhost:3000`.\n\n### Unterstützte Events (Client an Server)\nDer Server erwartet JSON-Payloads im folgenden Format:\n\n```json\n{\n  \"event\": \"join\" | \"startTyping\" | \"stopTyping\" | \"message\",\n  \"chat_id\": 123,\n  \"username\": \"Max\",\n  \"message\": \"Hallo!\" // (Nur bei event: message)\n}\n```\n\n### Antworten (Server an Client)\nDer Server sendet Nachrichten im Format:\n```json\n{\n  \"event\": \"message\"| \"stopTyping\" | \"startTyping\" | \"error\",\n  \"data\": { ... }\n}\n```"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Lokaler Entwicklungsserver"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Authentifizierung und Token-Management"
    },
    {
      "name": "Prompts",
      "description": "Erstellung und Abfrage von Prompts"
    },
    {
      "name": "Categories",
      "description": "Verwaltung der Kategorien"
    },
    {
      "name": "Chatrooms",
      "description": "Chat-Räume beitreten und Nachrichten lesen"
    }
  ],
  "paths": {
    "/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Benutzer anmelden",
        "operationId": "loginUser",
        "description": "Prüft Credentials und setzt accessToken & refreshToken als HttpOnly Cookies.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserLogin" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginSuccessResponse" }
              }
            }
          },
          "400": {
            "description": "Missing or invalid fields",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Invalid Credentials",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          }
        }
      }
    },
    "/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Neuen Benutzer registrieren",
        "operationId": "registerUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/User" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "400": {
            "description": "Missing or invalid fields",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" }
              }
            }
          },
          "409": {
            "description": "Username already exists",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          }
        }
      }
    },
    "/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Access Token erneuern",
        "operationId": "refreshToken",
        "security": [{ "refreshToken": [] }],
        "description": "Liest den refreshToken Cookie und stellt einen neuen accessToken Cookie aus.",
        "responses": {
          "200": {
            "description": "Token refreshed successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "401": {
            "description": "Refresh token required | Invalid or expired token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          }
        }
      }
    },
    "/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Benutzer abmelden",
        "operationId": "logoutUser",
        "description": "Löscht die accessToken und refreshToken Cookies.",
        "responses": {
          "200": {
            "description": "Logged out successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          }
        }
      }
    },
    "/category": {
      "get": {
        "tags": ["Categories"],
        "summary": "Alle Kategorien abrufen",
        "operationId": "getAllCategories",
        "responses": {
          "200": {
            "description": "Liste aller Kategorien (kann auch leer sein)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Category" }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          }
        }
      }
    },
    "/prompt": {
      "get": {
        "tags": ["Prompts"],
        "summary": "Alle Prompts abrufen",
        "operationId": "getAllPrompts",
        "responses": {
          "200": {
            "description": "Liste aller Prompts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Prompt" }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Prompts"],
        "summary": "Einen neuen Prompt erstellen",
        "operationId": "createPrompt",
        "security": [{ "accessToken": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewPrompt" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Prompt erfolgreich erstellt (kein Response-Body)"
          },
          "400": {
            "description": "Missing or invalid fields | Failed to create prompt or Category does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/ValidationErrorResponse" },
                    { "$ref": "#/components/schemas/MessageResponse" }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Authentication required | Invalid or expired token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          }
        }
      }
    },
    "/prompt/{id}": {
      "get": {
        "tags": ["Prompts"],
        "summary": "Prompt über ID abrufen",
        "operationId": "getPromptById",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Der gewünschte Prompt",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Prompt" }
              }
            }
          },
          "400": {
            "description": "Invalid prompt id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "404": {
            "description": "Prompt with ID {id} not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          }
        }
      }
    },
    "/chat-overview": {
      "get": {
        "tags": ["Chatrooms"],
        "summary": "Übersicht der Chaträume des Benutzers",
        "operationId": "getChatOverview",
        "security": [{ "accessToken": [] }],
        "responses": {
          "200": {
            "description": "Liste der Chaträume",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ChatroomOverview" }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required | Invalid or expired token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          }
        }
      }
    },
    "/chat/{id}": {
      "get": {
        "tags": ["Chatrooms"],
        "summary": "Nachrichten eines Chatraums abrufen",
        "operationId": "getChatMessages",
        "security": [{ "accessToken": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste von Chat-Nachrichten",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/UserChatMessage" }
                }
              }
            }
          },
          "400": {
            "description": "Invalid chat id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "401": {
            "description": "Authentication required | Invalid or expired token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          }
        }
      }
    },
    "/chat/join/{prompt_id}": {
      "post": {
        "tags": ["Chatrooms"],
        "summary": "Einem Chatraum beitreten oder erstellen",
        "operationId": "joinOrCreateChatroom",
        "security": [{ "accessToken": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "prompt_id",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "201": {
            "description": "Chatraum betreten (gibt die Chat ID zurück)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChatroomId" }
              }
            }
          },
          "400": {
            "description": "Invalid prompt id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "401": {
            "description": "Authentication required | Invalid or expired token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "404": {
            "description": "Prompt was not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "accessToken": {
        "type": "apiKey",
        "in": "cookie",
        "name": "accessToken",
        "description": "Wird für die meisten Routen benötigt. Wird beim Login gesetzt."
      },
      "refreshToken": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refreshToken",
        "description": "Wird nur für die /refresh Route benötigt."
      }
    },
    "schemas": {
      "MessageResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string" }
        }
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "required": ["message", "errors"],
        "properties": {
          "message": { "type": "string" },
          "errors": {
            "type": "object",
            "properties": {
              "errors": {
                "type": "array",
                "items": { "type": "string" }
              },
              "properties": {
                "type": "object",
                "additionalProperties": { "$ref": "#/components/schemas/FieldError" }
              }
            }
          }
        }
      },
      "LoginSuccessResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "username": { "type": "string" }
        }
      },
      "User": {
        "type": "object",
        "required": ["username", "password", "email", "profile_description"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "profile_description": { "type": "string", "nullable": true }
        }
      },
      "UserLogin": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string" }
        }
      },
      "Category": {
        "type": "object",
        "required": ["category_id", "title", "description"],
        "properties": {
          "category_id": { "type": "integer" },
          "title": { "type": "string" },
          "description": { "type": "string", "nullable": true }
        }
      },
      "Prompt": {
        "type": "object",
        "required": ["prompt_id", "category_title", "username", "title", "description", "time_stamp"],
        "properties": {
          "prompt_id": { "type": "integer" },
          "category_title": { "type": "string" },
          "username": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "time_stamp": { "type": "string", "format": "date-time" }
        }
      },
      "NewPrompt": {
        "type": "object",
        "required": ["category_id", "title", "description"],
        "properties": {
          "category_id": { "type": "integer" },
          "title": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "ChatroomOverview": {
        "type": "object",
        "required": ["chat_id", "chatroom_time_stamp", "prompt_id", "prompt_title", "prompt_description", "category_title"],
        "properties": {
          "chat_id": { "type": "integer" },
          "chatroom_time_stamp": { "type": "string", "format": "date-time" },
          "prompt_id": { "type": "integer" },
          "prompt_title": { "type": "string" },
          "prompt_description": { "type": "string" },
          "category_title": { "type": "string" }
        }
      },
      "ChatroomId": {
        "type": "object",
        "required": ["chat_id"],
        "properties": {
          "chat_id": { "type": "integer" }
        }
      },
      "UserChatMessage": {
        "type": "object",
        "required": ["username", "message", "time_stamp"],
        "properties": {
          "username": { "type": "string" },
          "message": { "type": "string", "nullable": true },
          "time_stamp": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}