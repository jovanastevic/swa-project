---
export const prerender = false;
import Layout from '@/layouts/Layout.astro';
import {Chat} from '@/components/Chat.tsx'
import { promptsApi } from '@/lib/api';

const { prompt } = Astro.params;

if (!prompt) {
    return Astro.redirect('/404');
}

// if (isNaN(promptId)) {
//     return Astro.redirect('/404');
// }

const id = parseInt(prompt);
const response = await promptsApi.getPromptById({id});
---
<Layout>
    <main class="flex flex-col items-center min-h-screen p-4">
        <Chat client:only="react" promptId={id} promptTitle={response.title} />
    </main>
</Layout>