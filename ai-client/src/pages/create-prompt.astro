---
import Layout from '../layouts/Layout.astro';
// import { CreatePromptCard } from "../components/CreatePromptCard.tsx"
import {CreatePromptCard} from "../components/CreatePromptCard.tsx"
import {categoriesApi} from "@/lib/api.ts";
import type { CategoryOption } from "../components/CreatePromptCard.tsx";

const data = await categoriesApi.getAllCategories();
const categories: CategoryOption[] = data.map((c) => ({
    label: c.title,
    value: c.category_id,
}));
//const categories = await api.getCategories(); //works, aber combobox füllen zu zach
---
<!--page user is receiving after pressing the plus icon in the header -->
<Layout>
    <main class="flex flex-col items-center min-h-screen p-4">
        <CreatePromptCard client:load categories={categories} />
        <!--<CreatePromptCard client:load />-->
    </main>
</Layout>